#!/usr/bin/env bash
#MISE description="Set this GitHub repo's merge settings and main-branch ruleset; needs repo admin"
set -euo pipefail

repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner)

gh api --method PATCH "repos/${repo}" --silent \
  -F allow_auto_merge=true \
  -F allow_squash_merge=true \
  -F allow_merge_commit=false \
  -F allow_rebase_merge=false \
  -F allow_update_branch=true \
  -F delete_branch_on_merge=true

# 15368 is the GitHub Actions app; actor 5 is the repository admin role.
ruleset='{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {"ref_name": {"include": ["~DEFAULT_BRANCH"], "exclude": []}},
  "bypass_actors": [{"actor_type": "RepositoryRole", "actor_id": 5, "bypass_mode": "always"}],
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {"type": "required_linear_history"},
    {"type": "pull_request", "parameters": {
      "required_approving_review_count": 0,
      "dismiss_stale_reviews_on_push": false,
      "required_reviewers": [],
      "require_code_owner_review": false,
      "dismissal_restriction": {"enabled": false, "allowed_actors": []},
      "require_last_push_approval": false,
      "required_review_thread_resolution": false,
      "require_extra_approval_for_unattributed_changes": true,
      "allowed_merge_methods": ["squash"]
    }},
    {"type": "required_status_checks", "parameters": {
      "strict_required_status_checks_policy": true,
      "do_not_enforce_on_create": false,
      "required_status_checks": [
        {"context": "Lint and test", "integration_id": 15368},
        {"context": "Audit dependencies", "integration_id": 15368},
        {"context": "Mutation-test the change", "integration_id": 15368}
      ]
    }}
  ]
}'

id=$(gh api "repos/${repo}/rulesets" --jq '.[] | select(.source_type == "Repository" and .name == "main") | .id')
if [[ -n ${id} ]]; then
  gh api --method PUT "repos/${repo}/rulesets/${id}" --input - --silent <<<"${ruleset}"
else
  gh api --method POST "repos/${repo}/rulesets" --input - --silent <<<"${ruleset}"
fi
